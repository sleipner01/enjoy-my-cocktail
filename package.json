{
  "name": "webdev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://cocktail.magnusbyrkjeland.no",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "test": "vitest",
    "coverage": "vitest run --coverage --reporter=junit --outputFile.junit=./coverage/junit.xml",
    "build": "bun run lint && bun run lint:css && tsc && vite build",
    "build:ci": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx,json .",
    "lint:css": "stylelint \"src/**/*{css, js, ts, tsx, jsx}\"",
    "lint:css:fix": "stylelint --fix \"src/**/*{css, js, ts, tsx, jsx}\"",
    "preview": "vite preview",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,scss,json,css}' --config .prettierrc.cjs"
  },
  "dependencies": {
    "@tanstack/query-sync-storage-persister": "^4.33.0",
    "@tanstack/react-query": "^4.33.0",
    "@tanstack/react-query-persist-client": "^4.33.0",
    "@vercel/analytics": "^1.3.1",
    "axios": "^1.5.0",
    "msw": "^1.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^4.10.1",
    "react-router-dom": "^6.15.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "9",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jsdom": "^30.1.1",
    "postcss-less": "^6.0.0",
    "postcss-lit": "^1.1.0",
    "prettier": "^3.0.3",
    "stylelint": "^15.10.3",
    "stylelint-config-standard": "^34.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "bun@1.4.2"
}
